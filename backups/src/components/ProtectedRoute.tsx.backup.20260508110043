import { useEffect, useState } from 'react';
import { Navigate, useLocation } from 'react-router-dom';
import type { Session } from '@supabase/supabase-js';
import { isSupabaseConfigured, supabase } from '../lib/supabase';

interface ProtectedRouteProps {
  children: React.ReactNode;
  allowedRoles?: string[];
}

interface AppUser {
  id: string;
  email: string;
  full_name: string | null;
  role: 'admin' | 'manager' | 'viewer';
  is_active: boolean;
}

export default function ProtectedRoute({
  children,
  allowedRoles = ['admin', 'manager', 'viewer'],
}: ProtectedRouteProps) {
  const location = useLocation();

  const [session, setSession] = useState<Session | null>(null);
  const [appUser, setAppUser] = useState<AppUser | null>(null);
  const [loading, setLoading] = useState(true);
  const [accessError, setAccessError] = useState('');

  useEffect(() => {
    let mounted = true;

    const checkAccess = async () => {
      setLoading(true);
      setAccessError('');

      if (!isSupabaseConfigured) {
        setAccessError('Supabase is not configured.');
        setLoading(false);
        return;
      }

      const { data: sessionData, error: sessionError } = await supabase.auth.getSession();

      if (!mounted) return;

      if (sessionError || !sessionData.session) {
        setSession(null);
        setAppUser(null);
        setLoading(false);
        return;
      }

      setSession(sessionData.session);

      const { data: userRow, error: userError } = await supabase
        .from('users')
        .select('id, email, full_name, role, is_active')
        .eq('id', sessionData.session.user.id)
        .maybeSingle();

      if (!mounted) return;

      if (userError) {
        console.error('Failed to read public.users profile:', userError);
        setAccessError('Could not verify your user role. Make sure the users table migration has been run.');
        setAppUser(null);
        setLoading(false);
        return;
      }

      if (!userRow) {
        setAccessError('Your login exists, but no matching row was found in the users table.');
        setAppUser(null);
        setLoading(false);
        return;
      }

      const typedUser = userRow as AppUser;
      setAppUser(typedUser);

      if (!typedUser.is_active) {
        setAccessError('Your account is inactive. Contact the system administrator.');
      } else if (!allowedRoles.includes(typedUser.role)) {
        setAccessError('You do not have permission to access this page.');
      }

      setLoading(false);
    };

    checkAccess();

    const {
      data: { subscription },
    } = supabase.auth.onAuthStateChange(() => {
      checkAccess();
    });

    return () => {
      mounted = false;
      subscription.unsubscribe();
    };
  }, [allowedRoles]);

  if (!isSupabaseConfigured) {
    return <Navigate to="/login" replace state={{ from: location }} />;
  }

  if (loading) {
    return (
      <div className="min-h-screen bg-charcoal-700 pt-28 flex items-center justify-center px-4">
        <div className="bg-white rounded-2xl shadow-2xl p-8 max-w-sm w-full text-center">
          <div className="w-12 h-12 border-4 border-sunny-400 border-t-transparent rounded-full animate-spin mx-auto mb-4" />
          <p className="font-heading font-700 text-charcoal-800">Checking access...</p>
          <p className="font-body text-charcoal-500 text-sm mt-1">Verifying your session and role.</p>
        </div>
      </div>
    );
  }

  if (!session) {
    return <Navigate to="/login" replace state={{ from: location }} />;
  }

  if (accessError || !appUser || !appUser.is_active || !allowedRoles.includes(appUser.role)) {
    return (
      <div className="min-h-screen bg-charcoal-700 pt-28 flex items-center justify-center px-4">
        <div className="bg-white rounded-3xl shadow-2xl p-8 max-w-md w-full text-center">
          <div className="w-14 h-14 rounded-2xl bg-sunny-400/15 flex items-center justify-center mx-auto mb-5">
            <span className="font-heading font-800 text-2xl text-sunny-600">!</span>
          </div>

          <h1 className="font-heading font-800 text-2xl text-charcoal-800 mb-2">
            Access denied
          </h1>

          <p className="font-body text-charcoal-500 text-sm leading-relaxed mb-6">
            {accessError || 'You do not have permission to access this page.'}
          </p>

          <button
            type="button"
            onClick={async () => {
              await supabase.auth.signOut();
              window.location.href = '/login';
            }}
            className="w-full bg-sunny-400 hover:bg-sunny-500 text-charcoal-800 font-heading font-800 py-3 rounded-xl transition-colors"
          >
            Back to Login
          </button>
        </div>
      </div>
    );
  }

  return <>{children}</>;
}
