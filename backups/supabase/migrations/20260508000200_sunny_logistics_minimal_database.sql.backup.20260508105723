#!/usr/bin/env bash
set -euo pipefail

echo "🔐 Adding styled login and dashboard routes"
echo "------------------------------------------"

if [ ! -f "package.json" ] || [ ! -d "src" ]; then
  echo "❌ Run this script from the project root folder, where package.json and src/ exist."
  exit 1
fi

mkdir -p backups
stamp=$(date +%Y%m%d%H%M%S)

for file in \
  src/App.tsx \
  src/pages/Login.tsx \
  src/pages/Dashboard.tsx \
  src/components/ProtectedRoute.tsx
do
  if [ -f "$file" ]; then
    mkdir -p "backups/$(dirname "$file")"
    cp "$file" "backups/$file.backup.$stamp"
  fi
done

echo "✅ Backups created in ./backups"

mkdir -p src/pages src/components

